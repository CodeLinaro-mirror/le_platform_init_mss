#! /bin/sh
target_name=`cat /sys/devices/soc0/machine`
if [ "$target_name" == "APQ8053" ]; then
 user="-c system"
fi
set -e

case "$1" in
start)
    echo -n "Starting atreset: "
    start-stop-daemon $user -S -b -a /sbin/init_mss
    echo "done"
    ;;
  stop)
    echo -n "Stopping atreset: "
    start-stop-daemon -K -n init_mss
    echo "done"
    ;;
  restart)
    $0 stop
    $0 start
    ;;
  *)
    echo "Usage init_mss{ start | stop | restart }" >&2
    exit 1
    ;;
esac

exit 0
